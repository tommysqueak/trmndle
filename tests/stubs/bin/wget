#!/bin/sh
: "${STUB_LOG:=/dev/null}"
url=
file=
want_file=0
for arg in "$@"; do
    if [ "$want_file" -eq 1 ]; then
        file=$arg
        want_file=0
        continue
    fi
    case "$arg" in
        -O) want_file=1 ;;
        -*) ;;
        *) [ -n "$url" ] || url=$arg ;;
    esac
done
echo "wget $url -> $file" >> "$STUB_LOG"
[ -n "$url" ] || exit 2
case "${STUB_WGET_MODE:-ok}" in
    fail) exit "${STUB_WGET_CODE:-4}" ;;
    *)
        if [ -n "$file" ]; then
            if [ -n "$STUB_WGET_BODY_FILE" ]; then
                cp "$STUB_WGET_BODY_FILE" "$file"
            else
                printf '%s' "${STUB_WGET_BODY:-FAKEPNG}" > "$file"
            fi
        fi
        ;;
esac
exit 0
